---
import ExperienceItem from "@/components/ExperienceItem.astro";
import SectionTitle from "@/components/SectionTitle.astro";

const EXPERIENCE = [
  {
    date: "December 2022 - November 2026",
    yoe: "(3 years 11 months)",
    title: "Front-End Developer",
    company: "Zapp Studio",
    link: "https://zapp-studio.com/",
    description:
      "Led the frontend of a national-scale agricultural management platform built with Angular. Developed and maintained multiple CMS platforms with Nuxt 2/3/4 and Vuetify, including an IoT CMS for the remote control of solar-powered water pumps (49 screens, ~64 REST endpoints, real-time monitoring with Mercure/SSE and Chart.js), a fuel-management CMS for an international refrigerated-transport group (21 screens, 3 microservices, Google Maps integration) and a municipal management platform for a European city with an internal chat built from scratch. More recently I've been working with AI coding agents (Claude, Codex, OpenCode) under Spec-Driven Development, treating the specification as an architectural artefact.",
  },
  {
    date: "March 2022 - November 2022",
    yoe: "(9 months, including 3 months of internship)",
    title: "Web Developer",
    company: "Capgemini",
    link: "https://www.capgemini.com/es-es/",
    description:
      "Led an internal research initiative evaluating immersive 3D web technologies — Three.js, React Three Fiber and Angular Three — and built the same prototype in Angular, Vue and React to assess which scaled best for the company's needs, documenting the reasoning behind the decision. The final prototype used React Three Fiber with TypeScript, Tailwind CSS, Redux and MongoDB, with real-time physics, animations and collision detection. Delivered the findings in an internal English-language presentation to over 100 employees.",
  },
];
---

<SectionTitle title="Experience" />

<ol class="relative border-s-2 border-neutral-300">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-4">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
